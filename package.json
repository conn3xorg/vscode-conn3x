{
  "name": "conn3x",
  "displayName": "Conn3x",
  "description": "Completion, hover docs, inline validation, highlighting and step snippets for Conn3x circuit files (.circuit.hcl).",
  "version": "0.3.0",
  "publisher": "conn3x",
  "license": "MPL-2.0",
  "icon": "images/icon.png",
  "homepage": "https://conn3x.org",
  "repository": { "type": "git", "url": "https://github.com/conn3xorg/vscode-conn3x" },
  "bugs": { "url": "https://github.com/conn3xorg/vscode-conn3x/issues" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Snippets", "Linters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:conn3x-circuit"],
  "keywords": ["conn3x", "circuit", "hcl", "opentofu", "ansible", "configuration management"],
  "contributes": {
    "languages": [
      {
        "id": "conn3x-circuit",
        "aliases": ["Conn3x circuit", "circuit"],
        "extensions": [".circuit.hcl", ".task.hcl", ".plan.hcl"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./images/icon.png", "dark": "./images/icon.png" }
      }
    ],
    "grammars": [
      { "language": "conn3x-circuit", "scopeName": "source.hcl.conn3x", "path": "./syntaxes/circuit.tmLanguage.json" }
    ],
    "snippets": [
      { "language": "conn3x-circuit", "path": "./snippets/conn3x.json" }
    ],
    "configuration": {
      "title": "Conn3x",
      "properties": {
        "conn3x.path": { "type": "string", "default": "", "description": "The conn3x binary to run for validation. Empty means conn3x on PATH." },
        "conn3x.validateOnSave": { "type": "boolean", "default": true, "description": "Run conn3x validate when a circuit or .tf file is saved, in a directory where conn3x init has run, and show what it finds in the file." }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "test": "node --test test/*.test.mjs",
    "modules": "node scripts/gen-modules.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  }
}
